# Contact form (src/app/actions/contact.ts). Required in production — the app
# fails to start without them (see src/instrumentation.ts).

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=you@example.com

# Contact-form rate limiting (src/lib/rate-limit.ts). Required in production.
# On Vercel, add the Upstash (Redis) integration from the Marketplace; it sets
# KV_REST_API_URL / KV_REST_API_TOKEN automatically. A hand-made Upstash
# database exposes these as UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN;
# either pair works. Leave unset locally to use the in-memory fallback.
KV_REST_API_URL=https://xxxx.upstash.io
KV_REST_API_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
